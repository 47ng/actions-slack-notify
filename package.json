{
  "name": "actions-slack-notify",
  "version": "1.0.2",
  "private": true,
  "description": "TypeScript template action",
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "deadcode": "knip",
    "test": "vitest run",
    "package": "tsdown",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm deadcode && pnpm test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@slack/webhook": "7.0.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@slack/types": "2.21.1",
    "@types/node": "^24.0.0",
    "knip": "6.14.2",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.7"
  },
  "packageManager": "pnpm@11.5.0"
}
